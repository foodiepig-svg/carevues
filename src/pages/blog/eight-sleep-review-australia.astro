            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Pod Pro</strong> (Queen)</td>
              <td>~$2,595</td>
              <td>~$3,800–4,200</td>
              <td>Active Grid + full sleep tracking</td>
            </tr>
            <tr>
              <td><strong>Pod Air</strong> (Queen)</td>
              <td>~$1,595</td>
